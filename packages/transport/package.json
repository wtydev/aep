{
  "name": "@wty.dev/aep-transport",
  "version": "1.0.0",
  "description": "AEP transport bindings: in-memory, NDJSON stdio and directory bindings",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wtydev/aep",
    "directory": "packages/transport"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "aep",
    "audio",
    "protocol",
    "transport",
    "ipc"
  ],
  "homepage": "https://github.com/wtydev/aep#readme",
  "bugs": {
    "url": "https://github.com/wtydev/aep/issues"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@wty.dev/aep-schema": "workspace:*",
    "@wty.dev/aep-core": "workspace:*"
  }
}
