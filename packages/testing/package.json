{
  "name": "@wty.dev/aep-testing",
  "version": "1.0.0",
  "description": "AEP conformance suite for hosts and the reference engine",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wtydev/aep",
    "directory": "packages/testing"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "aep",
    "audio",
    "protocol",
    "conformance",
    "testing"
  ],
  "homepage": "https://github.com/wtydev/aep#readme",
  "bugs": {
    "url": "https://github.com/wtydev/aep/issues"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@wty.dev/aep-schema": "workspace:*",
    "@wty.dev/aep-core": "workspace:*",
    "@wty.dev/aep-client": "workspace:*",
    "@wty.dev/aep-transport": "workspace:*"
  },
  "peerDependencies": {
    "@wty.dev/aep-host": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@wty.dev/aep-host": {
      "optional": true
    }
  },
  "devDependencies": {
    "@wty.dev/aep-host": "workspace:*"
  },
  "bin": {
    "aep-conformance": "./dist/cli.js"
  }
}
