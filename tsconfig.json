{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "paths": { "@aep/*": ["./packages/*/src/index.ts"] }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tests/**/*.ts",
    "examples/*/src/**/*.ts",
    "vitest.config.ts"
  ]
}
