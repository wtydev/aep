{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "baseRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "message": {
            "type": "string",
            "maxLength": 1200
          },
          "operationIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "entity": {
            "type": "string",
            "enum": [
              "project",
              "tempo",
              "meter",
              "trackOrder",
              "track",
              "instrument",
              "effectOrder",
              "effect",
              "clip",
              "note",
              "midiEvents",
              "automationLane",
              "section",
              "asset"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "update"
            ]
          },
          "before": {},
          "after": {},
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "entity",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "valid",
    "baseRevision",
    "diagnostics",
    "changes"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/wtydev/aep/schemas/1.0.0/transaction-validate-result.schema.json"
}
