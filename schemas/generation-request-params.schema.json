{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parameters": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "target": {
      "type": "object",
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "range": {
          "type": "object",
          "properties": {
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "enum": [
                "beats",
                "seconds",
                "samples"
              ]
            }
          },
          "required": [
            "start",
            "end",
            "unit"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "generator"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/wtydev/aep/schemas/0.1.0/generation-request-params.schema.json"
}
