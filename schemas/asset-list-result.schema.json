{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "mediaType": {
            "type": "string",
            "pattern": "^[a-z]+\\/[a-z0-9.+-]+$"
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "sampleRate": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "missing",
              "pending"
            ]
          },
          "portability": {
            "default": "host-local",
            "type": "string",
            "enum": [
              "portable",
              "host-local"
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "generator": {
                "type": "string",
                "maxLength": 256
              },
              "generatorVersion": {
                "type": "string",
                "maxLength": 64
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "seed": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "engine": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "sourceRevision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "additionalProperties": false
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "mediaType",
          "availability",
          "portability"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "assets"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/wtydev/aep/schemas/0.1.0/asset-list-result.schema.json"
}
