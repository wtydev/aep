{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "enum": [
        "mix",
        "stems",
        "tracks"
      ]
    },
    "trackIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "beats",
            "seconds",
            "samples"
          ]
        }
      },
      "required": [
        "start",
        "end",
        "unit"
      ],
      "additionalProperties": false
    },
    "format": {
      "type": "object",
      "properties": {
        "container": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "wav",
                "flac",
                "mp3",
                "ogg",
                "aiff"
              ]
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            }
          ]
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 768000
        },
        "bitDepth": {
          "anyOf": [
            {
              "type": "number",
              "const": 16
            },
            {
              "type": "number",
              "const": 24
            },
            {
              "type": "number",
              "const": 32
            }
          ]
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "container"
      ],
      "additionalProperties": false
    },
    "preview": {
      "default": false,
      "type": "boolean"
    },
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "required": [
    "target",
    "format"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/wtydev/aep/schemas/1.0.0/render-request-params.schema.json"
}
