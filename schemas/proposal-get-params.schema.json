{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "includeState": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "proposalId"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/wtydev/aep/schemas/0.1.0/proposal-get-params.schema.json"
}
