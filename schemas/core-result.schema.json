{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "mep/core/1"
    },
    "session": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "workspace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "rejected",
        "failed",
        "indeterminate"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "output": {},
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "next": {
          "type": "string",
          "enum": [
            "none",
            "fix",
            "reread",
            "ask_user",
            "reconcile"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "code",
        "next",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "session",
    "workspace",
    "id",
    "status"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/wtydev/aep/schemas/0.1.0/core-result.schema.json"
}
